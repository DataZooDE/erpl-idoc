) TO '__TEST_DIR__/edge_bad_3.idoc' (FORMAT sap_idoc);

statement error
SELECT dat FROM sap_idoc_read_segment('__TEST_DIR__/edge_bad_3.idoc', 'ZEDGE', 'edge_dict', typed := true);
