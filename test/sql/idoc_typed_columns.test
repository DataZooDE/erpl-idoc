# name: test/sql/idoc_typed_columns.test
# description: sap_idoc_read_segment(typed := true) maps DATS/TIMS and dictionary-scaled DEC/QUAN/CURR to SQL types
# group: [erpl_idoc]

require erpl_idoc

# --- default behaviour is unchanged: every column is VARCHAR ------------------------
query TT
SELECT typeof(flightdate), flightdate
FROM sap_idoc_read_segment('test/fixtures/flight.idoc', 'E1BPSBONEW', 'test/fixtures/flight_dict.csv');
----
VARCHAR	20260715

# --- typed := true on the real fixture: DATS -> DATE, NUMC/CHAR stay text ------------
query TTTTT
SELECT typeof(flightdate), flightdate, typeof(connectid), connectid, passbirth
FROM sap_idoc_read_segment('test/fixtures/flight.idoc', 'E1BPSBONEW', 'test/fixtures/flight_dict.csv', typed := true);
----
DATE	2026-07-15	VARCHAR	0400	1980-01-01

# --- a dictionary that supplies `decimals` (SAP's PT_FIELDS does not) ------------------
statement ok
CREATE TABLE typed_dict AS SELECT * FROM (VALUES
  ('ZTYPED', 1, 'DAT', 0,  8, 'DATS', NULL),
  ('ZTYPED', 2, 'TIM', 8,  6, 'TIMS', NULL),
  ('ZTYPED', 3, 'AMT', 14, 12, 'DEC',  2),
  ('ZTYPED', 4, 'QTY', 26, 10, 'QUAN', 3),
  ('ZTYPED', 5, 'NOD', 36, 8,  'DEC',  NULL),
  ('ZTYPED', 6, 'ID',  44, 6,  'NUMC', NULL),
  ('ZTYPED', 7, 'TXT', 50, 5,  'CHAR', NULL)
) t(segnam, field_pos, field_name, "offset", length, datatype, decimals);

# an IDoc: the fixture's control record + ZTYPED data records
#   1: fully populated   2: blanks, negative quantity with trailing minus
statement ok
COPY (
  SELECT raw FROM (
    SELECT 0 AS ord, raw_record AS raw FROM sap_idoc_read_raw('test/fixtures/flight.idoc') WHERE record_index = 0
    UNION ALL
    SELECT 1, sap_idoc_encode_data_record('ZTYPED','001',8,1,0,1,
      sap_idoc_encode_sdata([0,8,14,26,36,44,50],[8,6,12,10,8,6,5],
        ['20261231','235959','1234.50','12.345','9.9','000042','abc']))
    UNION ALL
    SELECT 2, sap_idoc_encode_data_record('ZTYPED','001',8,2,0,1,
      sap_idoc_encode_sdata([0,8,14,26,36,44,50],[8,6,12,10,8,6,5],
        ['00000000','','','5.000-','','','']))
  ) ORDER BY ord
) TO '__TEST_DIR__/typed_good.idoc' (FORMAT sap_idoc);

query IIIIIIII
SELECT segnum::INT, dat, tim, amt, qty, nod, id, txt
FROM sap_idoc_read_segment('__TEST_DIR__/typed_good.idoc', 'ZTYPED', 'typed_dict', typed := true)
ORDER BY 1;
----
1	2026-12-31	23:59:59	1234.50	12.345	9.9	000042	abc
2	NULL	NULL	NULL	-5.000	(empty)	(empty)	(empty)

# the SQL types themselves; DEC without a `decimals` value stays VARCHAR (nothing is invented)
query TTTTTT
SELECT typeof(dat), typeof(tim), typeof(amt), typeof(qty), typeof(nod), typeof(id)
FROM sap_idoc_read_segment('__TEST_DIR__/typed_good.idoc', 'ZTYPED', 'typed_dict', typed := true) LIMIT 1;
----
DATE	TIME	DECIMAL(12,2)	DECIMAL(10,3)	VARCHAR	VARCHAR

# without typed := true the same dictionary yields text only
query TTT
SELECT typeof(dat), typeof(amt), amt
FROM sap_idoc_read_segment('__TEST_DIR__/typed_good.idoc', 'ZTYPED', 'typed_dict') WHERE segnum::INT = 1;
----
VARCHAR	VARCHAR	1234.50

# --- bad values: strict (default) errors with a precise message, strict := false -> NULL
statement ok
COPY (
  SELECT raw FROM (
    SELECT 0 AS ord, raw_record AS raw FROM sap_idoc_read_raw('test/fixtures/flight.idoc') WHERE record_index = 0
    UNION ALL
    SELECT 1, sap_idoc_encode_data_record('ZTYPED','001',8,1,0,1,
      sap_idoc_encode_sdata([0,8,14,26,36,44,50],[8,6,12,10,8,6,5],
        ['20261301','250000','12x4','1.5','','','']))
  ) ORDER BY ord
) TO '__TEST_DIR__/typed_bad.idoc' (FORMAT sap_idoc);

statement error
SELECT dat FROM sap_idoc_read_segment('__TEST_DIR__/typed_bad.idoc', 'ZTYPED', 'typed_dict', typed := true);
----
field 'DAT' (DATS) has invalid value '20261301'

query TTTT
SELECT dat, tim, amt, qty
FROM sap_idoc_read_segment('__TEST_DIR__/typed_bad.idoc', 'ZTYPED', 'typed_dict', typed := true, strict := false);
----
NULL	NULL	NULL	1.500

# --- round trip: typed read -> format back to SAP text -> re-encode == original SDATA --
query I
SELECT sap_idoc_encode_sdata([0,8,14,26,36,44,50],[8,6,12,10,8,6,5],
         [strftime(dat,'%Y%m%d'), replace(tim::VARCHAR, ':', ''), amt::VARCHAR, qty::VARCHAR, nod, id, txt])
     = sap_idoc_encode_sdata([0,8,14,26,36,44,50],[8,6,12,10,8,6,5],
         ['20261231','235959','1234.50','12.345','9.9','000042','abc'])
FROM sap_idoc_read_segment('__TEST_DIR__/typed_good.idoc', 'ZTYPED', 'typed_dict', typed := true)
WHERE segnum::INT = 1;
----
true
