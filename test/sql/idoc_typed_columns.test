# the error also says where: segment type and number, and the file
statement error
SELECT dat FROM sap_idoc_read_segment('__TEST_DIR__/edge_bad_1.idoc', 'ZEDGE', 'edge_dict', typed := true);
----
segment ZEDGE #000001

# strict := false turns every one of them into NULL (glob over all six files)
query I
SELECT count(*) FROM sap_idoc_read_segment('__TEST_DIR__/edge_bad_*.idoc', 'ZEDGE', 'edge_dict', typed := true, strict := false)
WHERE dat IS NULL AND tim IS NULL AND amt IS NULL;
----
6

# `strict` is meaningless without `typed`: say so instead of silently ignoring it
statement error
SELECT * FROM sap_idoc_read_segment('__TEST_DIR__/edge_ok.idoc', 'ZEDGE', 'edge_dict', strict := false);
----
strict requires typed := true

# negative quantities: SAP writes a trailing minus; the documented write-back reproduces it
query TT
SELECT qty, CASE WHEN qty < 0 THEN abs(qty)::VARCHAR || '-' ELSE qty::VARCHAR END
FROM sap_idoc_read_segment('__TEST_DIR__/typed_good.idoc', 'ZTYPED', 'typed_dict', typed := true)
WHERE qty < 0;
----
-5.000	5.000-
