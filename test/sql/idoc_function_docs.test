# name: test/sql/idoc_function_docs.test
# description: Every function erpl_idoc registers documents itself in duckdb_functions()
# group: [erpl_idoc]

require erpl_idoc

statement ok
LOAD erpl_idoc

# ============================================================================
# Nothing this extension registers is left undocumented
#
# Enumerated, not allow-listed. An allow-list of names passes green while the
# functions it forgets to mention stay undocumented.
# ============================================================================

query I
SELECT count(*) FROM duckdb_functions()
WHERE function_name LIKE 'sap_idoc%'
  AND (description IS NULL OR description = ''
       OR len(examples) = 0
       OR len(categories) = 0
       OR list_contains(parameters, 'col0'));
----
0

# ============================================================================
# The reader family: one description for the whole overload set
#
# This is the regression that matters. RegisterDocTableFunctionSet used to push
# one FunctionDescription PER OVERLOAD, and every one of them was silently
# discarded: duckdb_functions() matches a description by comparing its
# parameter_types against the overload's, rejecting any candidate of a
# different SIZE, and these descriptions deliberately set no parameter_types
# (the whole point of the set is that the first argument may be VARCHAR or
# LIST(VARCHAR), so pinning types would knock out one overload).
#
# The single escape hatch is that ONE description applies to every overload
# regardless. So N copies meant N candidates of size 0 against an overload of
# size >= 1 -- all disqualified -- and the entire reader family reported NULL
# descriptions and col0 parameters even though the call sites supplied both.
#
# Asserting on a reader proves the set path works, not just the single path.
# ============================================================================

query I
SELECT count(*) FROM duckdb_functions()
WHERE function_name IN ('sap_idoc_read', 'sap_idoc_read_control', 'sap_idoc_read_raw',
                        'sap_idoc_read_segment', 'sap_idoc_read_fields')
  AND description IS NOT NULL AND description <> '';
----
10

# Both overloads of each reader -- VARCHAR path and LIST(VARCHAR) -- are covered.
query I
SELECT count(*) FROM duckdb_functions() WHERE function_name = 'sap_idoc_read';
----
2

# ============================================================================
# Parameter names, including the named parameters
#
# duckdb_functions() replaces the whole parameter list once parameter_names is
# non-empty: it walks positional arguments FOLLOWED BY named ones and pads any
# shortfall with col1, col2. So naming only 'path' would have rendered
# (path, col1, col2, col3, col4) and destroyed the named-parameter names.
#
# The named parameters come out in case_insensitive_map_t order, which is
# neither sorted nor guaranteed stable -- these pin the rendered list so a
# reordering fails loudly instead of silently misnaming every argument.
# ============================================================================

query I
SELECT DISTINCT parameters FROM duckdb_functions() WHERE function_name = 'sap_idoc_read';
----
[path, filename, encoding, lenient, framing]

query I
SELECT DISTINCT parameters FROM duckdb_functions() WHERE function_name = 'sap_idoc_read_segment';
----
[path, segnam, dict, filename, encoding, lenient, framing]

query I
SELECT DISTINCT parameters FROM duckdb_functions() WHERE function_name = 'sap_idoc_read_fields';
----
[path, dict, filename, include_unknown, encoding, lenient, framing]

# ============================================================================
# Macros carry descriptions too
#
# CreateInternalMacroInfo / CreateTableMacroInfo build the info but leave
# descriptions empty, which is why macros normally arrive undocumented.
# ============================================================================

query I
SELECT count(*) FROM duckdb_functions()
WHERE function_name IN ('sap_idoc_params', 'sap_idoc_dictionary')
  AND description IS NOT NULL AND description <> '' AND len(examples) > 0;
----
2

# The macros already reported their own parameter names; documenting them must
# not have replaced those with col0.
query I
SELECT parameters FROM duckdb_functions() WHERE function_name = 'sap_idoc_params';
----
[idoctyp, cimtyp, version]
